EMAIL_AGENT_MODEL=  # Optional: override default NVIDIA model (e.g., openai:gpt-4)
EMAIL_NVIDIA_API_KEY=your_nvidia_api_key

# Google Configuration
EMAIL_GOOGLE_CREDENTIALS_PATH=credentials.json
EMAIL_GOOGLE_TOKEN_PATH=token.json
EMAIL_GOOGLE_API_KEY=  # Optional: For Google Search API
EMAIL_GOOGLE_CSE_ID=  # Optional: For Google Custom Search Engine

# For production persistence, add your PostgreSQL URI and swap InMemorySaver.
POSTGRES_URL=postgresql://user:password@localhost:5432/email_assistant
